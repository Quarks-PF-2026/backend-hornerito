DATABASE_URL=postgresql://hornerito:hornerito@db:5432/hornerito
JWT_SECRET=change-me
JWT_EXPIRES_IN_SECONDS=3600

# URL del frontend, usada para armar los links de verificación e invitación.
APP_BASE_URL=http://localhost:4200

# SMTP. Si falta alguno de los tres, los correos se loguean en vez de enviarse.
# Gmail: SMTP_PASS es una contraseña de aplicación, no la del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Hornerito <no-reply@hornerito.app>
